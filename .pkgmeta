package-as: SkillGuideForever

# Dev tools stay in git but are not shipped to CurseForge / Wago / WoWI.
ignore:
  - tools
  - media
  - dist
  - update-data.ps1
  - update-data.bat
  - package.ps1
  - release.ps1
  - upload-curseforge.ps1
  - PUBLISHING.md
  - RELEASE.md
  - .github
  - .gitignore

manual-changelog: CHANGELOG.md
